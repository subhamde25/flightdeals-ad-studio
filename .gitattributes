# Normalise line endings; shell/JS/Python must stay LF so they run on any OS
* text=auto
*.sh   text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.py   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.json text eol=lf

# Final videos are ~50 MB each: store them with Git LFS (GitHub warns above 50 MB, rejects above 100 MB)
*.mp4 filter=lfs diff=lfs merge=lfs -text

# Other binaries (small, kept in normal Git)
*.png   binary
*.jpg   binary
*.woff2 binary
*.mp3   binary
*.wav   binary
